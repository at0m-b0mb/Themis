#!/usr/bin/env python3
"""themis-ap -- bring up the Themis exam access point on Linux (Kali, Pi, any distro).

The whole policy lives here, in files you can read:
    hostapd   the radio, client isolation, and real association events
    dnsmasq   DHCP and a sinkhole resolver with no upstream
    nftables  default-deny

    themis-ap preflight   check this host is fit to run an exam
    themis-ap render      write the configs, change nothing
    themis-ap up          render, then start the AP
    themis-ap down        stop it and hand the interface back
    themis-ap status      what is running, and what it can honestly claim

Preflight is the point of this program. Every check in it exists because getting
it wrong means a failure during a graded exam.
"""

from __future__ import annotations

import ipaddress
import json
import os
import re
import secrets
import pathlib
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TEMPLATES = ROOT / "templates"
POLICY = ROOT / "policy.json"
RUN_DIR = Path("/run/themis")
STATE = RUN_DIR / "state.json"
JOURNAL = RUN_DIR / "exam.jsonl"

# mt7921u will not run an AP on a DFS channel. US non-DFS 5 GHz channels:
NON_DFS_5GHZ = {36, 40, 44, 48, 149, 153, 157, 161, 165}
# AP mode for mt7921u landed in 5.19.
MIN_KERNEL = (5, 19)
# The Bluetooth side of an MT7921AU crashes its Wi-Fi side on 6.6+.
BT_MODULES = ("btusb", "btmtk")

ASSURANCE = {
    "airgap": [
        ("Online answer lookup", "BLOCKED", "no route off this network exists"),
        ("Cloud AI (ChatGPT, Claude, Gemini)", "BLOCKED", "same -- no egress path"),
        ("VPN", "IMPOSSIBLE", "a VPN client has no server it can reach"),
        ("Tor", "IMPOSSIBLE", "no bridge or directory authority is reachable"),
        ("DNS tunnelling", "IMPOSSIBLE", "the resolver runs no-resolv: no upstream, so no exit"),
        ("Student-to-student", "BLOCKED BY THE RADIO", "hostapd ap_isolate. Note the nftables forward chain does NOT back this up: traffic between two clients of one AP is relayed inside the radio at layer 2 and never reaches the IP forward hook"),
        ("Local AI model on their laptop", "NOT BLOCKED", "runs offline, emits no traffic -- invisible to any network control"),
        ("Phone on cellular", "NOT BLOCKED", "never touches this network -- a human in the room is the only control"),
        ("Leaving for another network", "DETECTED AT THE RADIO", "hostapd reports the disassociation; blocking it would be illegal"),
    ],
    "allowlist": [
        ("Online answer lookup", "PARTLY BLOCKED", "only allowlisted names resolve, but an allowed host may embed or proxy others"),
        ("Cloud AI (ChatGPT, Claude, Gemini)", "PARTLY BLOCKED", "direct endpoints unreachable; a permitted domain could relay"),
        ("VPN", "PARTLY BLOCKED", "arbitrary destinations are dropped, but see domain fronting in docs/THREAT_MODEL.md"),
        ("Tor", "PARTLY BLOCKED", "same caveat"),
        ("DNS tunnelling", "BLOCKED", "only allowlisted domains are forwarded; the rest sinkhole"),
        ("Student-to-student", "BLOCKED BY THE RADIO", "hostapd ap_isolate. Note the nftables forward chain does NOT back this up: traffic between two clients of one AP is relayed inside the radio at layer 2 and never reaches the IP forward hook"),
        ("Local AI model on their laptop", "NOT BLOCKED", "runs offline, emits no traffic"),
        ("Phone on cellular", "NOT BLOCKED", "never touches this network"),
        ("Leaving for another network", "DETECTED AT THE RADIO", "hostapd reports the disassociation"),
    ],
}


def die(msg: str, code: int = 1):
    print(f"themis-ap: {msg}", file=sys.stderr)
    raise SystemExit(code)


def run(cmd, check=True, **kw):
    """Run a command, surviving a missing binary.

    subprocess.run raises FileNotFoundError when the program does not exist, which
    made `preflight` traceback on a host without rfkill instead of reporting what
    was missing. A diagnostic that dies when a tool is absent fails at exactly the
    job it exists to do, so a missing binary is now a 127 result like any other
    failure, and only `check=True` callers escalate.
    """
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, **kw)
    except (OSError, subprocess.SubprocessError) as e:
        if check:
            die(f"{' '.join(cmd)}: {e}")
        return subprocess.CompletedProcess(cmd, 127, "", str(e))
    if check and p.returncode != 0:
        die(f"{' '.join(cmd)}\n  exit {p.returncode}: {(p.stderr or p.stdout).strip()}")
    return p


def out(cmd) -> str:
    return run(cmd, check=False).stdout


def load_policy() -> dict:
    if not POLICY.exists():
        die(f"no policy at {POLICY}")
    try:
        pol = json.loads(POLICY.read_text())
    except json.JSONDecodeError as e:
        die(f"policy.json is not valid JSON: {e}")
    if pol.get("profile") not in ASSURANCE:
        die(f"unknown profile {pol.get('profile')!r}")
    if pol["profile"] == "allowlist" and not pol.get("uplink_interface"):
        die("profile 'allowlist' requires uplink_interface")
    return pol


def kernel_version() -> tuple[int, int]:
    m = re.match(r"(\d+)\.(\d+)", os.uname().release)
    return (int(m.group(1)), int(m.group(2))) if m else (0, 0)


def iface_driver(iface: str) -> str | None:
    link = Path(f"/sys/class/net/{iface}/device/driver")
    try:
        return link.resolve().name
    except OSError:
        return None


def loaded_modules() -> set[str]:
    try:
        return {l.split()[0] for l in Path("/proc/modules").read_text().splitlines() if l.split()}
    except OSError:
        return set()


def supports_ap(iface: str) -> bool | None:
    """True/False from `iw list`, or None if we could not tell."""
    phy = Path(f"/sys/class/net/{iface}/phy80211")
    if not phy.exists():
        return None
    text = out(["iw", "list"])
    if not text:
        return None
    block = re.search(r"Supported interface modes:(.*?)(?:\n\s*\w[\w ]*:|\Z)", text, re.S)
    return ("* AP" in block.group(1)) if block else None


def nm_manages(iface: str) -> bool:
    """NetworkManager will tear down an interface hostapd is using. This is the
    single most common reason a hand-rolled AP 'randomly' stops working."""
    if not shutil.which("nmcli"):
        return False
    for line in out(["nmcli", "-t", "-f", "DEVICE,STATE", "device"]).splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and parts[0] == iface:
            return parts[1] not in ("unmanaged", "unavailable")
    return False


def rfkill_blocked(iface: str) -> bool | None:
    """True/False, or None when rfkill is not installed so we genuinely do not know."""
    if not shutil.which("rfkill"):
        return None
    txt = out(["rfkill", "list"])
    return bool(re.search(r"(Soft|Hard) blocked:\s*yes", txt))


def bt_blacklisted() -> bool:
    """Is btusb blacklisted on disk, so it cannot load later?

    Checking only /proc/modules answers "has it loaded yet", which is a different
    and much weaker question -- and it reads as a pass before the adapter is even
    attached, which is precisely when it is most misleading.
    """
    d = pathlib.Path("/etc/modprobe.d")
    if not d.is_dir():
        return False
    for f in d.glob("*.conf"):
        try:
            for line in f.read_text(errors="replace").splitlines():
                parts = line.split("#", 1)[0].split()
                if len(parts) >= 2 and parts[0] == "blacklist" and parts[1] == "btusb":
                    return True
        except OSError:
            continue
    return False


def centre_index(channel: int, width: int) -> int:
    if width >= 80:
        base = 36 if channel <= 48 else 149
        return base + 6
    if width == 40:
        return channel + 2
    return channel


# --------------------------------------------------------------------------- #

class EgressPolicyError(Exception):
    """allow_egress contains something nftables cannot safely express."""


def _check_egress_are_addresses(entries) -> None:
    """Refuse hostnames in allow_egress, loudly and with the reason.

    nftables resolves names once at load time and rejects outright any name that
    resolves to several addresses ("Hostname resolves to multiple addresses"), which
    is every CDN-hosted service including Canvas. Even where it loads, the result is
    an ADDRESS allowlist: a student can reach any other site sharing those addresses
    by setting a different TLS SNI, and the address set goes stale the moment the CDN
    rotates. So a hostname here would produce either a config that will not load or
    a control that does not control. Both are worse than saying no.
    """
    bad = []
    for e in entries:
        try:
            ipaddress.ip_network(str(e), strict=False)
        except ValueError:
            bad.append(str(e))
    if bad:
        raise EgressPolicyError(
            "allow_egress must contain IP addresses or CIDR ranges, not hostnames.\n"
            f"  offending entries: {', '.join(bad)}\n"
            "\n"
            "  Why: nftables rejects any hostname resolving to multiple addresses, which\n"
            "  is every CDN-hosted service. And an address allowlist does not stop a\n"
            "  student reaching other sites on the same CDN addresses by changing the TLS\n"
            "  SNI -- so even when it loads, it does not do what it looks like it does.\n"
            "\n"
            "  Either:\n"
            "    - use profile 'airgap' and serve the exam locally (strongest, and the\n"
            "      only configuration in which VPN and Tor are impossible rather than\n"
            "      merely blocked), or\n"
            "    - pin explicit addresses here and accept that they go stale, or\n"
            "    - route students through a validating CONNECT proxy, which is the only\n"
            "      way to filter by NAME rather than by address. See docs/THREAT_MODEL.md."
        )


def render(pol: dict) -> dict[str, str]:
    stamp = time.strftime("%Y-%m-%d %H:%M:%S %Z")
    prof, ap_if, srv = pol["profile"], pol["ap_interface"], pol["server_ip"]
    width = int(pol.get("channel_width_mhz", 80))
    ch = int(pol["channel"])

    if width >= 80:
        chw, seg = 1, centre_index(ch, 80)
    else:
        chw, seg = 0, centre_index(ch, width)
    width_block = (
        f"vht_oper_chwidth={chw}\n"
        f"vht_oper_centr_freq_seg0_idx={seg}\n"
        f"he_oper_chwidth={chw}\n"
        f"he_oper_centr_freq_seg0_idx={seg}"
    )

    ent = pol.get("enterprise") or {}
    if ent.get("enabled"):
        auth_block = (
            "# Tier 2 identity: each student authenticates with their own credential, so\n"
            "# identity is bound to MAC at association, before any web request happens.\n"
            "wpa_key_mgmt=WPA-EAP\n"
            "ieee8021x=1\n"
            "eap_server=1\n"
            f"eap_user_file={ent.get('eap_user_file', '/etc/hostapd/themis.eap_user')}\n"
        )
    else:
        mode = str(pol.get("security", "wpa2+wpa3")).lower()
        pmf = int(pol.get("pmf", 1))
        if mode not in ("wpa2", "wpa2+wpa3", "wpa3"):
            raise EgressPolicyError(
                f"security must be one of wpa2, wpa2+wpa3, wpa3 -- got {mode!r}")
        if mode == "wpa3":
            # SAE only. Per-session keys, no offline dictionary attack, and PMF is
            # mandatory under WPA3 so deauth frames are authenticated.
            keymgmt, pmf = "SAE", 2
            extra = f"sae_password={pol['passphrase']}\n"
        elif mode == "wpa2+wpa3":
            # Transition mode: SAE for clients that can, PSK for those that cannot.
            keymgmt = "WPA-PSK SAE"
            extra = (f"wpa_passphrase={pol['passphrase']}\n"
                     f"sae_password={pol['passphrase']}\n"
                     "sae_require_mfp=1\n")
        else:
            keymgmt, extra = "WPA-PSK", f"wpa_passphrase={pol['passphrase']}\n"
        auth_block = (
            "# 802.11w. Without management-frame protection, deauthentication frames\n"
            "# are unauthenticated and any student can disconnect classmates -- which\n"
            "# then reads as a genuine drop in the proctor console.\n"
            f"ieee80211w={pmf}\n"
            f"wpa_key_mgmt={keymgmt}\n"
            + extra
        )

    hostapd = (TEMPLATES / "hostapd.conf.tmpl").read_text()
    for k, v in {
        "PROFILE": prof, "STAMP": stamp, "AP_IF": ap_if, "SSID": pol["ssid"],
        "COUNTRY": pol["country_code"], "CHANNEL": ch, "WIDTH_BLOCK": width_block,
        "AUTH_BLOCK": auth_block,
        "AP_ISOLATE": 1 if pol.get("client_isolation", True) else 0,
        "MAX_STA": pol.get("max_stations", 25),
    }.items():
        hostapd = hostapd.replace("{{%s}}" % k, str(v))

    if prof == "allowlist":
        up = pol["uplink_interface"]
        _check_egress_are_addresses(pol["allow_egress"])
        fwd = [f'    iifname "{ap_if}" oifname "{up}" ip daddr {{ {", ".join(pol["allow_egress"])} }} tcp dport {{ 80, 443 }} accept',
               "    ct state established,related accept"]
        forward_block = "\n".join(fwd)
        nat_table = (
            "\n  chain postrouting {\n"
            "    type nat hook postrouting priority srcnat; policy accept;\n"
            f'    oifname "{up}" ip saddr {pol["network_cidr"]} masquerade\n'
            "  }\n"
        )
    else:
        forward_block = (
            "    # Profile 'airgap': nothing is forwarded anywhere. Student-to-student is\n"
            "    # dropped here as well as by hostapd ap_isolate, and there is no uplink\n"
            "    # for a VPN or Tor client to reach. This emptiness is the guarantee."
        )
        nat_table = ("\n  # Profile 'airgap': no postrouting chain, because there is no\n"
                     "  # uplink to translate to. The redirect above is the only\n"
                     "  # translation here, and it only ever points at this host.\n")

    nft = (TEMPLATES / "nftables.conf.tmpl").read_text()
    for k, v in {
        "PROFILE": prof, "STAMP": stamp, "AP_IF": ap_if, "NET": pol["network_cidr"],
        "SRV": srv, "PORTS": ", ".join(str(p) for p in pol.get("server_ports", [80])),
        "FORWARD_BLOCK": forward_block, "NAT_POSTROUTING": nat_table,
    }.items():
        nft = nft.replace("{{%s}}" % k, str(v))

    if prof == "allowlist":
        # dnsmasq filters by NAME, so it reads allow_dns_names. nftables filters by
        # ADDRESS and reads allow_egress. They are separate lists on purpose; a
        # single list cannot serve both layers.
        dns_body = (
            "# Only these names resolve upstream; everything else sinkholes to the portal.\n"
            "# Ceiling: this filters NAMES, not content. A permitted name that proxies\n"
            "# other sites defeats it, and nftables must separately permit the addresses\n"
            "# those names resolve to -- see allow_egress.\n"
            + "".join(f"server=/{d}/1.1.1.1\n" for d in pol.get("allow_dns_names", []))
            + f"address=/#/{srv}\n"
        )
    else:
        dns_body = (
            "# Sinkhole: every name resolves to the exam server, which answers with a\n"
            "# plain 'blocked during exam' page and logs the attempt.\n"
            f"address=/#/{srv}\n"
        )

    bits = int(pol.get("netmask_bits", 24))
    netmask = ".".join(str((0xFFFFFFFF << (32 - bits) >> s) & 0xFF) for s in (24, 16, 8, 0))

    dns = (TEMPLATES / "dnsmasq.conf.tmpl").read_text()
    for k, v in {
        "PROFILE": prof, "STAMP": stamp, "AP_IF": ap_if,
        "DHCP_START": pol["dhcp_range"][0], "DHCP_END": pol["dhcp_range"][1],
        "NETMASK": netmask, "DHCP_LEASE": pol.get("dhcp_lease", "3h"),
        "SRV": srv, "RUN_DIR": str(RUN_DIR), "DNS_BODY": dns_body,
    }.items():
        dns = dns.replace("{{%s}}" % k, str(v))

    return {"hostapd.conf": hostapd, "nftables.conf": nft, "dnsmasq.conf": dns}


def write_rendered(pol: dict) -> dict[str, Path]:
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    paths = {}
    for name, text in render(pol).items():
        p = RUN_DIR / name
        p.write_text(text)
        paths[name] = p
    return paths


# --------------------------------------------------------------------------- #

def wireless_interfaces() -> list[str]:
    """Interface names that have a wiphy, i.e. are actually radios."""
    out = []
    net = Path("/sys/class/net")
    if not net.is_dir():
        return out
    for iface in sorted(net.iterdir()):
        if (iface / "phy80211").exists():
            out.append(iface.name)
    return out


def cmd_configure(pol: dict) -> int:
    """Set the AP interface and mint a fresh passphrase for this exam.

    A subcommand rather than a shell snippet because the passphrase should be
    rotated for every exam, and because a here-doc that calls input() reads EOF
    from the here-doc itself -- which is exactly how this started.
    """
    args = sys.argv[2:]
    iface = next((a for a in args if not a.startswith("-")), None)
    keep = "--keep-passphrase" in args

    radios = wireless_interfaces()
    if iface is None:
        print("usage: themis-ap configure <interface> [--keep-passphrase]\n")
        if radios:
            print("wireless interfaces on this host:")
            for r in radios:
                drv = iface_driver(r) or "?"
                mark = "  <- in-tree mt7921u, the one you want" if drv == "mt7921u" else ""
                print(f"  {r}   driver {drv}{mark}")
        else:
            print("no wireless interfaces found. Pass the adapter through to this VM")
            print("first, then check `ip link`.")
        return 1

    if radios and iface not in radios:
        print(f"themis-ap: {iface!r} is not a wireless interface on this host.",
              file=sys.stderr)
        print(f"  found: {', '.join(radios) or '(none)'}", file=sys.stderr)
        return 1

    pol["ap_interface"] = iface
    if not keep or pol.get("passphrase") == "CHANGE-ME-EVERY-EXAM":
        pol["passphrase"] = secrets.token_urlsafe(12)
    POLICY.write_text(json.dumps(pol, indent=2) + "\n")

    print(f"wrote {POLICY}\n")
    print(f"  interface   {iface}")
    print(f"  ssid        {pol['ssid']}")
    print(f"  passphrase  {pol['passphrase']}")
    print()
    print("  Write the passphrase on the board. It is rotated every time you run")
    print("  this, which is the point -- last term's passphrase should not work.")
    print()
    print("  Next:  sudo netguard/linux/bin/themis-ap preflight")
    return 0


def preflight_checks(pol: dict) -> dict:
    """Run every check and return the result as data.

    Same checks, same wording -- the CLI prints this and the operator UI renders
    it. One implementation, so the panel can never disagree with the terminal
    about whether the host is fit to run an exam.
    """
    fails, warns, oks = _collect(pol)
    return {
        "profile": pol.get("profile"),
        "ok": [{"level": "ok", "message": m} for m in oks],
        "warn": [{"level": "warn", "message": m} for m in warns],
        "fail": [{"level": "fail", "message": m} for m in fails],
        "ready": not fails,
        "blocking": len(fails),
    }


def cmd_preflight(pol: dict) -> int:
    if "--json" in sys.argv[2:]:
        print(json.dumps(preflight_checks(pol), indent=2))
        return 0 if preflight_checks(pol)["ready"] else 1
    fails, warns, oks = _collect(pol)
    _report(pol["profile"], fails, warns, oks)
    return 1 if fails else 0


def _collect(pol: dict):
    ap_if, prof = pol["ap_interface"], pol["profile"]
    fails, warns, oks = [], [], []

    if os.geteuid() != 0:
        warns.append("not root -- `up` and `down` will need sudo")

    if sys.platform != "linux":
        fails.append(f"this command runs on Linux; this host is {sys.platform}. "
                     f"On macOS use netguard/bin/themis-net instead.")
        return fails, warns, oks

    for tool in ("hostapd", "hostapd_cli", "dnsmasq", "nft", "iw", "ip"):
        if not shutil.which(tool):
            fails.append(f"{tool} not installed  (apt install hostapd dnsmasq nftables iw)")

    kv = kernel_version()
    if kv < MIN_KERNEL:
        fails.append(f"kernel {kv[0]}.{kv[1]} -- mt7921u AP mode needs {MIN_KERNEL[0]}.{MIN_KERNEL[1]}+")
    else:
        oks.append(f"kernel {kv[0]}.{kv[1]} supports mt7921u AP mode")

    # THE trap: MT7921AU's Bluetooth function crashes its Wi-Fi side on 6.6+.
    bt = sorted(loaded_modules() & set(BT_MODULES))
    blacklisted = bt_blacklisted()
    adapter_present = Path(f"/sys/class/net/{ap_if}").exists()
    bt_fix = (f"        sudo cp {TEMPLATES / 'blacklist-themis-bt.conf'} /etc/modprobe.d/\n"
              f"        sudo systemctl disable --now bluetooth\n"
              f"        sudo modprobe -r btusb btmtk   (or reboot)")
    if bt:
        fails.append(
            f"Bluetooth module(s) loaded: {', '.join(bt)}. On kernel 6.6+ this causes "
            f"sporadic mt7921u Wi-Fi crashes, which mid-exam is the worst failure this "
            f"project has. Fix:\n{bt_fix}"
        )
    elif blacklisted:
        oks.append("btusb is blacklisted on disk -- it cannot load when the adapter "
                   "is attached (the mt7921u crash trap is closed)")
    elif not adapter_present:
        # The dangerous case. Nothing has loaded btusb because nothing has asked it
        # to. Attaching an AWUS036AXML -- which carries Bluetooth on the same chip --
        # is exactly what asks it to, so reporting this as a pass would reassure the
        # reader at the one moment the reassurance is worthless.
        fails.append(
            "btusb is not loaded, but only because the adapter is not attached yet, "
            "and it is NOT blacklisted. The AWUS036AXML carries Bluetooth on the same "
            "chip, so attaching it will autoload btusb and put the mt7921u crash back "
            "on the table. Blacklist it BEFORE you pass the adapter through:\n" + bt_fix
        )
    else:
        warns.append(
            "btusb is not loaded and the adapter is attached, but btusb is not "
            "blacklisted -- nothing stops it loading on the next boot or replug:\n" + bt_fix
        )

    if not Path(f"/sys/class/net/{ap_if}").exists():
        fails.append(f"ap_interface {ap_if!r} does not exist. Plug the adapter in and check `ip link`.")
    else:
        drv = iface_driver(ap_if)
        if drv == "mt7921u":
            oks.append(f"{ap_if} is driven by the in-tree mt7921u driver")
        elif drv:
            warns.append(f"{ap_if} uses driver {drv!r}, not mt7921u. If this is the "
                         f"AWUS1900 (rtl8814au), it needs an out-of-tree DKMS module that "
                         f"breaks on kernel updates -- prefer the AWUS036AXML.")
        ap = supports_ap(ap_if)
        if ap is False:
            fails.append(f"`iw list` does not report AP in supported interface modes for {ap_if}")
        elif ap is None:
            warns.append(f"could not confirm AP mode support for {ap_if} from `iw list`")
        else:
            oks.append("the radio reports AP mode support")

        if nm_manages(ap_if):
            fails.append(
                f"NetworkManager is managing {ap_if} and will tear down the AP under "
                f"hostapd. Fix:  sudo nmcli device set {ap_if} managed no"
            )
        else:
            oks.append(f"NetworkManager is not managing {ap_if}")

    rf = rfkill_blocked(ap_if)
    if rf is True:
        fails.append("a radio is rfkill-blocked  (fix: sudo rfkill unblock all)")
    elif rf is None:
        warns.append("rfkill is not installed, so a soft-blocked radio cannot be "
                     "ruled out  (apt install rfkill)")

    if shutil.which("nft"):
        cur = out(["nft", "list", "ruleset"])
        tables = [l.strip() for l in cur.splitlines() if l.strip().startswith("table ")]
        if tables:
            warns.append(
                f"this host already has {len(tables)} nftables table(s); Themis replaces the "
                f"whole ruleset while the exam runs.\n"
                + "".join(f"        {t}\n" for t in tables[:6])
                + "        `up` saves them and `down` puts them back, but do not run this on a "
                  "host whose firewall matters."
            )

    ch = int(pol["channel"])
    if ch not in NON_DFS_5GHZ:
        fails.append(f"channel {ch} is DFS or invalid. mt7921u cannot run an AP on a DFS "
                     f"channel -- use one of {sorted(NON_DFS_5GHZ)}.")
    else:
        oks.append(f"channel {ch} is non-DFS")

    if pol.get("passphrase") == "CHANGE-ME-EVERY-EXAM" and not (pol.get("enterprise") or {}).get("enabled"):
        fails.append("passphrase is still the placeholder -- set a fresh one for this exam")

    try:
        fwd = Path("/proc/sys/net/ipv4/ip_forward").read_text().strip()
    except OSError:
        fwd = "?"
    if prof == "airgap" and fwd == "1":
        fails.append("ip_forward=1 but profile is 'airgap'. Students could route out through "
                     "this host and the air gap is a fiction.\n"
                     "        Fix: sudo sysctl -w net.ipv4.ip_forward=0")
    elif prof == "airgap":
        oks.append("ip forwarding is off -- no egress path exists for a VPN or Tor client")
    if prof == "allowlist" and fwd != "1":
        fails.append("profile 'allowlist' needs: sudo sysctl -w net.ipv4.ip_forward=1")

    if prof == "allowlist":
        names = pol.get("allow_dns_names") or []
        addrs = pol.get("allow_egress") or []
        if names and not addrs:
            fails.append("allow_dns_names is set but allow_egress is empty: names will "
                         "resolve and then every connection to them will be dropped")
        if addrs and not names:
            warns.append("allow_egress is set but allow_dns_names is empty: nothing will "
                         "resolve, so those addresses are only reachable by literal IP")
        if names or addrs:
            warns.append("an allowlist filters names in one layer and addresses in "
                         "another, and both go stale when the CDN rotates. Profile "
                         "'airgap' is the only one that can claim VPN and Tor are "
                         "impossible rather than merely blocked.")

    return fails, warns, oks


def _report(prof, fails, warns, oks):
    print(f"themis-ap preflight -- profile {prof!r}\n")
    for o in oks:
        print(f"  OK    {o}")
    for w in warns:
        print(f"  WARN  {w}")
    for f in fails:
        print(f"  FAIL  {f}")
    print()
    if fails:
        print(f"  {len(fails)} blocking problem(s). Not safe to run an exam yet.\n")
    elif warns:
        print("  ready, with warnings above\n")
    else:
        print("  ready to host an exam\n")


def cmd_render(pol: dict) -> int:
    try:
        paths = write_rendered(pol)
    except EgressPolicyError as e:
        die(str(e))
    for name, p in paths.items():
        print(f"rendered {p}")
    if shutil.which("nft"):
        p = run(["nft", "-c", "-f", str(paths["nftables.conf"])], check=False)
        if p.returncode != 0:
            print(f"\nnftables REJECTED the ruleset:\n{p.stderr.strip()}", file=sys.stderr)
            return 1
        print("\nnftables parsed the ruleset cleanly (nft -c).")
    return 0


def cmd_up(pol: dict) -> int:
    if os.geteuid() != 0:
        die("`up` must run as root: sudo netguard/linux/bin/themis-ap up")
    fails, warns, oks = _collect(pol)
    _report(pol["profile"], fails, warns, oks)
    if fails:
        die("preflight failed -- not touching the network")

    try:
        paths = write_rendered(pol)
    except EgressPolicyError as e:
        die(str(e))
    if run(["nft", "-c", "-f", str(paths["nftables.conf"])], check=False).returncode != 0:
        die("rendered nftables ruleset is invalid -- refusing to load it")

    ap_if, srv = pol["ap_interface"], pol["server_ip"]
    bits = pol.get("netmask_bits", 24)

    # The generated ruleset begins with `flush ruleset`, which removes EVERY
    # nftables rule on this host -- Docker's, libvirt's, the VM's own. Save what is
    # there so `down` can put it back, instead of leaving the operator to rebuild
    # their host firewall from memory after an exam.
    saved = RUN_DIR / "nftables.saved"
    prior = run(["nft", "list", "ruleset"], check=False)
    if prior.returncode == 0:
        saved.write_text(prior.stdout)
        n = len([l for l in prior.stdout.splitlines() if l.strip().startswith("table ")])
        print(f"saved the host's existing nftables ruleset ({n} table(s)) to {saved}")
    else:
        saved.write_text("")
        print("could not read the existing nftables ruleset; `down` will simply flush")

    STATE.write_text(json.dumps({"ap_interface": ap_if, "profile": pol["profile"],
                                 "started": time.time(),
                                 "saved_ruleset": str(saved)}, indent=2))

    def rollback(why: str) -> int:
        """Put the host back the way we found it.

        Without this, a failure halfway through leaves the exam firewall loaded and
        the host's own networking dead -- on the machine the operator is standing
        at, with students waiting.
        """
        print(f"\n{why}\nrolling back ...", file=sys.stderr)
        for name in ("hostapd_cli.pid", "hostapd.pid", "dnsmasq.pid"):
            pf = RUN_DIR / name
            if pf.exists():
                try:
                    os.kill(int(pf.read_text().strip()), 15)
                except (ProcessLookupError, ValueError, OSError):
                    pass
                pf.unlink(missing_ok=True)
        run(["nft", "flush", "ruleset"], check=False)
        if saved.exists() and saved.read_text().strip():
            run(["nft", "-f", str(saved)], check=False)
            print("  restored the previous nftables ruleset", file=sys.stderr)
        run(["ip", "addr", "flush", "dev", ap_if], check=False)
        run(["ip", "link", "set", ap_if, "down"], check=False)
        STATE.unlink(missing_ok=True)
        print("  host is back as it was. Nothing is broadcasting.", file=sys.stderr)
        return 1

    print(f"\nconfiguring {ap_if} as {srv}/{bits} ...")
    run(["ip", "addr", "flush", "dev", ap_if], check=False)
    if run(["ip", "addr", "add", f"{srv}/{bits}", "dev", ap_if], check=False).returncode != 0:
        return rollback(f"could not assign {srv}/{bits} to {ap_if}")
    if run(["ip", "link", "set", ap_if, "up"], check=False).returncode != 0:
        return rollback(f"could not bring {ap_if} up")

    print("loading nftables ruleset ...")
    r = run(["nft", "-f", str(paths["nftables.conf"])], check=False)
    if r.returncode != 0:
        return rollback(f"nftables refused the ruleset: {(r.stderr or '').strip()[:300]}")

    print("starting dnsmasq (DHCP + sinkhole DNS) ...")
    r = run([shutil.which("dnsmasq") or "dnsmasq", "-C", str(paths["dnsmasq.conf"])], check=False)
    if r.returncode != 0:
        return rollback("dnsmasq would not start -- students would associate and get "
                        f"no address:\n  {(r.stderr or r.stdout or '').strip()[:300]}")

    print("starting hostapd ...")
    log = (RUN_DIR / "hostapd.log").open("a")
    hp = subprocess.Popen(["hostapd", str(paths["hostapd.conf"])], stdout=log, stderr=log)
    (RUN_DIR / "hostapd.pid").write_text(str(hp.pid))

    # Wait for hostapd to actually CLAIM the radio, and notice if it dies trying.
    # Printing "exam AP is up" because a process was spawned is how an operator ends
    # up believing the exam network exists while students see nothing at all.
    ctrl = Path("/var/run/hostapd") / ap_if
    enabled = False
    for _ in range(40):                      # up to 10s
        if hp.poll() is not None:
            tail = (RUN_DIR / "hostapd.log").read_text(errors="replace")[-700:]
            return rollback(f"hostapd exited immediately (status {hp.returncode}):\n{tail}")
        if ctrl.exists():
            enabled = True
            break
        time.sleep(0.25)
    if not enabled:
        tail = (RUN_DIR / "hostapd.log").read_text(errors="replace")[-700:]
        return rollback("hostapd is running but never claimed the radio "
                        f"(no control socket at {ctrl} after 10s):\n{tail}")

    # The control socket exists, but AP-ENABLED is what says the beacon is out.
    beaconing = False
    for _ in range(20):                      # up to 5s more
        if "AP-ENABLED" in (RUN_DIR / "hostapd.log").read_text(errors="replace")[-4000:]:
            beaconing = True
            break
        if hp.poll() is not None:
            tail = (RUN_DIR / "hostapd.log").read_text(errors="replace")[-700:]
            return rollback(f"hostapd died while enabling the AP:\n{tail}")
        time.sleep(0.25)
    if not beaconing:
        print("  note: hostapd has the radio but has not logged AP-ENABLED yet.",
              file=sys.stderr)

    hook = ROOT / "bin" / "themis-sta-hook"
    if hook.exists():
        print("attaching association/disassociation hook ...")
        ch = subprocess.Popen(["hostapd_cli", "-i", ap_if, "-a", str(hook)],
                              stdout=log, stderr=log)
        (RUN_DIR / "hostapd_cli.pid").write_text(str(ch.pid))

    print("\nexam AP is up.\n")
    return cmd_status(pol)


def cmd_down(pol: dict) -> int:
    if os.geteuid() != 0:
        die("`down` must run as root: sudo netguard/linux/bin/themis-ap down")
    ap_if = pol["ap_interface"]
    if STATE.exists():
        try:
            ap_if = json.loads(STATE.read_text()).get("ap_interface", ap_if)
        except json.JSONDecodeError:
            pass

    for name in ("hostapd_cli.pid", "hostapd.pid", "dnsmasq.pid"):
        pf = RUN_DIR / name
        if not pf.exists():
            continue
        try:
            os.kill(int(pf.read_text().strip()), 15)
            print(f"stopped {name[:-4]}")
        except (ProcessLookupError, ValueError):
            print(f"{name[:-4]} was not running")
        pf.unlink(missing_ok=True)

    run(["nft", "flush", "ruleset"], check=False)
    saved = RUN_DIR / "nftables.saved"
    if saved.exists() and saved.read_text().strip():
        r = run(["nft", "-f", str(saved)], check=False)
        if r.returncode == 0:
            print("restored the nftables ruleset that was here before the exam")
        else:
            print(f"WARNING: could not restore the previous nftables ruleset.\n"
                  f"         It is still at {saved} -- reapply with: sudo nft -f {saved}\n"
                  f"         nft said: {(r.stderr or '').strip()[:200]}", file=sys.stderr)
    else:
        print("flushed nftables (there was nothing to restore)")
    run(["ip", "addr", "flush", "dev", ap_if], check=False)
    run(["ip", "link", "set", ap_if, "down"], check=False)
    print(f"released {ap_if}")
    STATE.unlink(missing_ok=True)
    print("\nexam AP is down.")
    return 0


def cmd_status(pol: dict) -> int:
    prof, ap_if = pol["profile"], pol["ap_interface"]
    hostapd_up = (RUN_DIR / "hostapd.pid").exists()
    dns_up = (RUN_DIR / "dnsmasq.pid").exists()

    stations = []
    if hostapd_up and shutil.which("hostapd_cli"):
        for line in out(["hostapd_cli", "-i", ap_if, "list_sta"]).splitlines():
            if re.match(r"^[0-9a-f:]{17}$", line.strip()):
                stations.append(line.strip())

    print(f"profile          {prof}")
    print(f"ssid             {pol['ssid']}  (channel {pol['channel']}, {pol.get('channel_width_mhz', 80)} MHz)")
    print(f"hostapd          {'running' if hostapd_up else 'not running'}")
    print(f"dnsmasq          {'running' if dns_up else 'not running'}")
    print(f"client isolation {'ON' if pol.get('client_isolation', True) else 'OFF'}")
    print(f"identity         {'WPA2-Enterprise (per-student credential)' if (pol.get('enterprise') or {}).get('enabled') else 'WPA2-PSK + captive portal (student asserts who they are)'}")
    print(f"stations         {len(stations)} associated")
    for s in stations:
        print(f"                 {s}")
    print()
    print("What this setup can honestly claim:")
    print()
    w = max(len(r[0]) for r in ASSURANCE[prof])
    for what, verdict, why in ASSURANCE[prof]:
        print(f"  {what.ljust(w)}  {verdict}")
        print(f"  {' '.ljust(w)}  ^ {why}")
    print()
    print("  Nothing here inspects a student's machine. It controls a network you own.")
    print()
    return 0


def main() -> int:
    cmds = {"configure": cmd_configure, "preflight": cmd_preflight,
            "render": cmd_render, "up": cmd_up, "down": cmd_down,
            "status": cmd_status}
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    if sys.argv[1] not in cmds:
        die(f"unknown command {sys.argv[1]!r}; try --help")
    return cmds[sys.argv[1]](load_policy())


if __name__ == "__main__":
    raise SystemExit(main())
