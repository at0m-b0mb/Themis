#!/usr/sbin/nft -f
# Themis exam network -- GENERATED by themis-ap, do not edit by hand.
# Profile: {{PROFILE}}   Rendered: {{STAMP}}

flush ruleset

table inet themis {
  chain input {
    type filter hook input priority filter; policy drop;

    iif lo accept

    # DHCP from students.
    iifname "{{AP_IF}}" udp dport 67 accept

    # DNS -- our resolver only. It has no upstream, so a DNS tunnel has no exit.
    iifname "{{AP_IF}}" ip saddr {{NET}} ip daddr {{SRV}} udp dport 53 accept
    iifname "{{AP_IF}}" ip saddr {{NET}} ip daddr {{SRV}} tcp dport 53 accept

    # The exam server.
    iifname "{{AP_IF}}" ip saddr {{NET}} ip daddr {{SRV}} tcp dport { {{PORTS}} } accept

    # Ping the server only, so a student can check whether it is up.
    iifname "{{AP_IF}}" ip saddr {{NET}} ip daddr {{SRV}} ip protocol icmp icmp type echo-request accept

    ct state established,related accept

    # Fail FAST rather than hang. A dropped packet makes a student stare at a
    # spinner for thirty seconds and assume the exam network is broken; a reset
    # tells the browser immediately, and is what makes the operating system's own
    # captive-portal detection pop the sign-in sheet.
    iifname "{{AP_IF}}" meta l4proto tcp reject with tcp reset
    iifname "{{AP_IF}}" reject
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
{{FORWARD_BLOCK}}
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
table ip themis_nat {
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;

    # Send ANY plain-HTTP request to the portal, whatever address it was aimed at.
    # Without this a browser holding a cached IP, or a student typing one, bypasses
    # the DNS sinkhole entirely and just hangs.
    iifname "{{AP_IF}}" tcp dport 80 ip daddr != {{SRV}} dnat to {{SRV}}
  }
{{NAT_POSTROUTING}}
}
