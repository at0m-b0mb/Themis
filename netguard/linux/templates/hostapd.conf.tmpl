# Themis exam AP -- GENERATED by themis-ap, do not edit by hand.
# Profile: {{PROFILE}}   Rendered: {{STAMP}}

interface={{AP_IF}}
driver=nl80211

ssid={{SSID}}
# Regulatory domain must be set or the radio will refuse channels it is allowed
# to use, and may pick illegal power levels.
country_code={{COUNTRY}}
ieee80211d=1

# --- Radio ------------------------------------------------------------------
# 5 GHz. mt7921u does NOT support DFS channels in AP mode, so {{CHANNEL}} must
# stay out of the DFS range -- themis-ap preflight enforces this.
hw_mode=a
channel={{CHANNEL}}

ieee80211n=1
ieee80211ac=1
ieee80211ax=1
wmm_enabled=1

ht_capab=[HT40+][SHORT-GI-20][SHORT-GI-40]
{{WIDTH_BLOCK}}

# --- Security ---------------------------------------------------------------
auth_algs=1
wpa=2
rsn_pairwise=CCMP
{{AUTH_BLOCK}}

# --- Exam-specific ----------------------------------------------------------
# Client isolation: students cannot reach each other over the radio at all.
# This is the first line against answer-sharing; nftables backs it up.
ap_isolate={{AP_ISOLATE}}

# Headroom over the real class size. Refusing to associate is a visible failure,
# which is better than silently degrading for everyone.
max_num_sta={{MAX_STA}}

# The SSID must be discoverable -- students have to find it.
ignore_broadcast_ssid=0

# Association and disassociation are reported to the control interface, which is
# where themis-sta-hook picks them up and writes them to the journal. This is why
# a disconnect is recorded at the radio, not guessed at by polling DHCP.
ctrl_interface=/var/run/hostapd
ctrl_interface_group=0

logger_syslog=-1
logger_syslog_level=2
