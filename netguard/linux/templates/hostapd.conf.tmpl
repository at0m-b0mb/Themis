# Themis exam AP -- GENERATED by themis-ap, do not edit by hand.
# Profile: {{PROFILE}}   Rendered: {{STAMP}}

interface={{AP_IF}}
# With two radios every AP is a port on one bridge, so a 2.4 GHz student and a
# 5 GHz student share one subnet, one DHCP server and one portal -- they see a
# single network and their device picks the band.
{{BRIDGE_LINE}}
driver=nl80211

ssid={{SSID}}
# Regulatory domain must be set or the radio will refuse channels it is allowed
# to use, and may pick illegal power levels.
country_code={{COUNTRY}}
ieee80211d=1

# --- Radio ------------------------------------------------------------------
# Band-dependent, and rendered rather than written here: hw_mode, the HT40
# direction and whether VHT applies at all differ between 2.4 and 5 GHz, and a
# fixed [HT40+] is simply wrong on half the legal channels.
{{RADIO_BLOCK}}

# --- Security ---------------------------------------------------------------
auth_algs=1
wpa=2
rsn_pairwise=CCMP
{{AUTH_BLOCK}}

# --- Exam-specific ----------------------------------------------------------
# Client isolation: students cannot reach each other over the radio at all.
# This is the first line against answer-sharing; nftables backs it up.
ap_isolate={{AP_ISOLATE}}

# A per-BSS station limit, so with two radios it applies to each band on its own.
# Set far above any plausible roster, because hitting it is NOT a visible failure:
# hostapd replies "unable to handle additional associated stations" and the laptop
# shows a generic "cannot connect", which looks exactly like a student who never
# arrived -- including in the proctor console.
max_num_sta={{MAX_STA}}

# The SSID must be discoverable -- students have to find it.
ignore_broadcast_ssid=0

# Association and disassociation are reported to the control interface, which is
# where themis-sta-hook picks them up and writes them to the journal. This is why
# a disconnect is recorded at the radio, not guessed at by polling DHCP.
ctrl_interface=/var/run/hostapd
ctrl_interface_group=0

logger_syslog=-1
logger_syslog_level=2
