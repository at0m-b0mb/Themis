# Themis exam network -- GENERATED by themis-ap, do not edit by hand.
# Profile: {{PROFILE}}   Rendered: {{STAMP}}

interface={{AP_IF}}
bind-interfaces
except-interface=lo

# --- DHCP -------------------------------------------------------------------
dhcp-range={{DHCP_START}},{{DHCP_END}},{{NETMASK}},{{DHCP_LEASE}}
dhcp-option=option:router,{{SRV}}
dhcp-option=option:dns-server,{{SRV}}
dhcp-authoritative
dhcp-leasefile={{RUN_DIR}}/dhcp.leases

# --- DNS --------------------------------------------------------------------
# no-resolv is load-bearing, not tidiness: with no upstream resolver, DNS
# tunnelling -- the classic captive-portal bypass -- has nowhere to exit to.
no-resolv
no-hosts
domain-needed
bogus-priv

{{DNS_BODY}}

# --- Evidence ---------------------------------------------------------------
# What the exam NETWORK was asked for. Nothing about what is installed on, or
# running on, any student's machine.
log-queries
log-dhcp
log-facility={{RUN_DIR}}/dnsmasq.log
pid-file={{RUN_DIR}}/dnsmasq.pid
