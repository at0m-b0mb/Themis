# Themis exam network -- GENERATED by themis-net, do not edit by hand.
# Profile: {{PROFILE}}   Rendered: {{STAMP}}

interface={{EXAM_IF}}
bind-interfaces
except-interface=lo0

# --- DHCP -------------------------------------------------------------------
dhcp-range={{DHCP_START}},{{DHCP_END}},{{NETMASK}},{{DHCP_LEASE}}
dhcp-option=option:router,{{SERVER_IP}}
dhcp-option=option:dns-server,{{SERVER_IP}}
dhcp-authoritative
dhcp-leasefile={{RUN_DIR}}/dhcp.leases

# --- DNS --------------------------------------------------------------------
# No upstream resolvers and no /etc/hosts: this resolver is an island.
no-resolv
no-hosts
domain-needed
bogus-priv

{{DNS_BODY}}

# --- Evidence ---------------------------------------------------------------
# Queries and leases are logged so a blocked lookup is visible to the proctor.
# This records what the EXAM NETWORK was asked for. It does not inspect,
# enumerate, or report on anything installed on a student's machine.
log-queries
log-dhcp
log-facility={{RUN_DIR}}/dnsmasq.log
pid-file={{RUN_DIR}}/dnsmasq.pid
