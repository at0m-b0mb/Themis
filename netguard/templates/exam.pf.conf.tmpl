exam_if   = "{{EXAM_IF}}"
exam_net  = "{{NETWORK_CIDR}}"
exam_srv  = "{{SERVER_IP}}"
exam_prts = "{ {{SERVER_PORTS}} }"

set skip on lo0
set block-policy drop

