# --- Filtering --------------------------------------------------------------
# Default: nothing moves.
block drop all

# DHCP: client broadcast reaches our server, and the offer goes back.
pass in  quick on $exam_if proto udp from any port 68 to any port 67
pass out quick on $exam_if proto udp from any port 67 to any port 68

# DNS: students may ask OUR resolver and nothing else.
pass in quick on $exam_if proto { tcp udp } from $exam_net to $exam_srv port 53

# The exam itself.
pass in  quick on $exam_if proto tcp from $exam_net to $exam_srv port $exam_prts
pass out quick on $exam_if proto tcp from $exam_srv port $exam_prts to $exam_net

# ICMP to the server only, so a student can check "is it up?".
pass in quick on $exam_if inet proto icmp from $exam_net to $exam_srv icmp-type echoreq

